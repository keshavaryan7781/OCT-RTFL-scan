#!/bin/bash
#PBS -N oct-nfl-test
#PBS -q gpu
#PBS -l select=1:ncpus=6:ngpus=1:mem=16gb
#PBS -l place=scatter:shared
#PBS -l walltime=01:00:00
#PBS -j oe

set -Ee -o pipefail
: "${PBS_JOBID:?Submit with qsub, not bash}"

cd "$HOME/OCT-RTFL"
mkdir -p outputs/logs

log_file="$PWD/outputs/logs/test_${PBS_JOBID}.log"
exec >> "$log_file" 2>&1

on_exit() {
    rc=$?
    trap - EXIT
    if [ "$rc" -ne 0 ]; then
        echo "FAILED: exit=$rc; inspect the preceding error."
        nvidia-smi || true
    fi
    date
    exit "$rc"
}
trap on_exit EXIT

date
hostname

# Use the same lock as training so this script cannot overlap
# with another cooperating job that changes this fold's checkpoints.
command -v flock >/dev/null
exec 9> outputs/logs/Dataset501_fold0.lock

if ! flock -n 9; then
    echo "Another training/inference job holds this fold's lock."
    exit 1
fi

mask_present="${CUDA_VISIBLE_DEVICES+x}"
incoming_mask="${CUDA_VISIBLE_DEVICES-}"

source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate oct_nfl
set -u

export nnUNet_raw="$PWD/nnUNet_raw"
export nnUNet_preprocessed="$PWD/nnUNet_preprocessed"
export nnUNet_results="$PWD/nnUNet_results"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export nnUNet_compile=false
export PYTHONUNBUFFERED=1
export MPLBACKEND=Agg

# Preserve an existing GPU mask; otherwise use the same
# manual GPU-selection approach as the successful training job.
if [ "$mask_present" = x ]; then
    export CUDA_VISIBLE_DEVICES="$incoming_mask"
else
    if [ "$(hostname -s)" != rachel-gpu ] ||
       [ -n "${PBS_GPUFILE:-}" ]; then
        echo "Unrecognized GPU assignment; stopping."
        exit 1
    fi

    gpu_uuid="$(
        nvidia-smi -i 1 --query-gpu=uuid --format=csv,noheader
    )"

    if [[ ! "$gpu_uuid" =~ ^GPU-[[:xdigit:]-]+$ ]]; then
        echo "Could not identify physical GPU 1."
        exit 1
    fi

    export CUDA_VISIBLE_DEVICES="$gpu_uuid"
fi

echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
nvidia-smi

# Separate output folder for each job; previous predictions are preserved.
export OCT_TEST_OUTPUT="$PWD/outputs/test_predictions/$PBS_JOBID"

python - <<'PY'
import csv
import hashlib
import json
import os
from importlib.metadata import version
from pathlib import Path

import torch


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


root = Path.cwd()
raw = Path(os.environ["nnUNet_raw"]) / "Dataset501_DukeNFL"
output = Path(os.environ["OCT_TEST_OUTPUT"])

checkpoint = (
    Path(os.environ["nnUNet_results"])
    / "Dataset501_DukeNFL"
    / "nnUNetTrainer_250epochs__nnUNetPlans__2d"
    / "fold_0"
    / "checkpoint_best.pth"
)

require(version("nnunetv2") == "2.8.1", "nnU-Net version changed.")
require(
    torch.__version__ == "2.5.1+cu121",
    "PyTorch version changed.",
)
require(
    checkpoint.is_file() and checkpoint.stat().st_size > 0,
    "Best checkpoint missing or empty.",
)

with (root / "outputs/audit/duke_manifest.csv").open() as handle:
    rows = list(csv.DictReader(handle))

test_rows = [row for row in rows if row["split"] == "test"]
expected = {row["case_id"] for row in test_rows}
development = {
    row["case_id"] for row in rows
    if row["split"] in {"train", "val"}
}

require(
    len(test_rows) == len(expected) == 22,
    "Expected 22 unique test cases.",
)
require(
    {row["subject_id"] for row in test_rows}
    == {"Subject_02", "Subject_09"},
    "Unexpected test subjects.",
)
require(
    expected.isdisjoint(development),
    "Test/development case overlap.",
)

actual_images = {
    path.name.removesuffix("_0000.png")
    for path in (raw / "imagesTs").glob("*_0000.png")
}
actual_labels = {
    path.stem for path in (raw / "labelsTs").glob("*.png")
}

require(actual_images == expected, "Test image IDs differ from manifest.")
require(actual_labels == expected, "Test label IDs differ from manifest.")

require(torch.cuda.is_available(), "CUDA unavailable.")
require(
    torch.cuda.device_count() == 1,
    "Expected exactly one visible GPU.",
)

free, total = torch.cuda.mem_get_info(0)
print("GPU:", torch.cuda.get_device_name(0))
print(f"Free VRAM: {free / 1024**3:.2f} / {total / 1024**3:.2f} GiB")
minimum_free_gib = 6.0

require(
    free >= minimum_free_gib * 1024**3,
    f"Only {free / 1024**3:.2f} GiB free; "
    f"need at least {minimum_free_gib:.1f} GiB startup headroom.",
)

require(
    not output.exists() or not any(output.iterdir()),
    "This job's output folder is already populated; refusing to overwrite.",
)
output.mkdir(parents=True, exist_ok=True)

# Record precisely which model produced these predictions.
digest = hashlib.sha256()
with checkpoint.open("rb") as handle:
    for chunk in iter(lambda: handle.read(1024 * 1024), b""):
        digest.update(chunk)

record = {
    "checkpoint": str(checkpoint),
    "checkpoint_sha256": digest.hexdigest(),
    "fold": 0,
    "test_case_ids": sorted(expected),
    "nnunet_version": version("nnunetv2"),
    "torch_version": torch.__version__,
}

(output / "evaluation_record.json").write_text(
    json.dumps(record, indent=2) + "\n"
)

print("Preflight passed: 22 held-out test scans.")
print("Output:", output)
PY

nnUNetv2_predict \
    -i "$nnUNet_raw/Dataset501_DukeNFL/imagesTs" \
    -o "$OCT_TEST_OUTPUT" \
    -d 501 \
    -c 2d \
    -f 0 \
    -tr nnUNetTrainer_250epochs \
    -p nnUNetPlans \
    -chk checkpoint_best.pth \
    -device cuda \
    -npp 2 \
    -nps 2 \
    --not_on_device \
    --save_probabilities \
    --disable_progress_bar
    
# Confirm that every requested case produced a readable mask.
python - <<'PY'
import json
import os
from pathlib import Path

import numpy as np
from PIL import Image

output = Path(os.environ["OCT_TEST_OUTPUT"])
raw = Path(os.environ["nnUNet_raw"]) / "Dataset501_DukeNFL"

record = json.loads((output / "evaluation_record.json").read_text())
expected = set(record["test_case_ids"])

if {p.stem for p in output.glob("*.png")} != expected:
    raise RuntimeError("Missing or unexpected prediction masks.")

if {p.stem for p in output.glob("*.npz")} != expected:
    raise RuntimeError("Missing or unexpected probability files.")

for case_id in sorted(expected):
    with Image.open(output / f"{case_id}.png") as handle:
        prediction = np.asarray(handle)

    with Image.open(raw / "imagesTs" / f"{case_id}_0000.png") as handle:
        expected_shape = (handle.height, handle.width)

    if prediction.shape != expected_shape:
        raise RuntimeError(f"Shape mismatch: {case_id}")

    if not set(np.unique(prediction)).issubset({0, 1}):
        raise RuntimeError(f"Unexpected predicted labels: {case_id}")

print("Verified all 22 prediction masks and probability-file names.")
print("SUCCESS: held-out test inference completed.")
print("Predictions:", output)
PY