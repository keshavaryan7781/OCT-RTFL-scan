#!/bin/bash
#PBS -N oct-prepare
#PBS -q workq
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -eo pipefail

cd "${PBS_O_WORKDIR:?Submit from the OCT-RTFL project root}"

source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate oct_nfl

source configs/nnunet_paths.sh

# Prevent each worker from spawning many numerical-library threads.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

# Stage 1: export verified images, masks, and subject split.
python -u src/data/prepare_nnunet.py

# Stage 2: validate, plan, and preprocess the 2D dataset.
nnUNetv2_plan_and_preprocess \
    -d 501 \
    -c 2d \
    -npfp 2 \
    -np 2 \
    --verify_dataset_integrity

echo "Dataset conversion and preprocessing completed."