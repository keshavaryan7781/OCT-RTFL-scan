#!/bin/bash
#PBS -N oct-gpu-check
#PBS -q gpu
#PBS -l select=1:ncpus=2:ngpus=1:mem=8gb
#PBS -l walltime=00:05:00
#PBS -j oe

set -eo pipefail

cd "${PBS_O_WORKDIR:?}"
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate oct_nfl

nvidia-smi

python - <<'PY'
import sys
import torch
from importlib.metadata import version, PackageNotFoundError

print("Python:", sys.version)
print("PyTorch:", torch.__version__)
print("PyTorch CUDA build:", torch.version.cuda)
print("CUDA available:", torch.cuda.is_available())

try:
    print("nnU-Net:", version("nnunetv2"))
except PackageNotFoundError:
    print("nnU-Net: NOT INSTALLED")

assert torch.cuda.is_available(), "CUDA unavailable inside the GPU job."

gpu = torch.cuda.get_device_properties(0)
print("GPU:", gpu.name)
print("VRAM GiB:", round(gpu.total_memory / 1024**3, 2))

x = torch.ones(8, device="cuda")
assert (x * 2).sum().item() == 16
print("CUDA computation passed.")
PY